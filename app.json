{
  "expo": {
    "name": "Dapto",
    "slug": "Dapto",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/daptao.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "splash": {
      "image": "./assets/daptao.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinfocom.dapto",
      "icon": "./assets/dapto-ios-icon.png",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Dapto uses the camera when you choose to take a prescription, clinic, or profile photo.",
        "NSPhotoLibraryUsageDescription": "Dapto uses your photo library when you choose an image to upload to your profile, clinic, chat, or health record.",
        "NSLocationWhenInUseUsageDescription": "Dapto uses your current location only when you choose to attach it to a patient health record."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/daptao.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vinfocom.dapto",
      "versionCode": 50000
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dapto uses the camera when you choose to take a prescription, clinic, or profile photo.",
          "photosPermission": "Dapto uses your photo library when you choose an image to upload to your profile, clinic, chat, or health record.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dapto uses your current location only when you choose to attach it to a patient health record.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "extra": {
      "apiUrl": "https://dapto.vinfocom.co.in/api",
      "socketUrl": "https://dapto.vinfocom.co.in",
      "eas": {
        "projectId": "1db0ddb0-7155-4300-a308-38afad0ddf76"
      }
    },
    "owner": "singhaditya1627"
  }
}
